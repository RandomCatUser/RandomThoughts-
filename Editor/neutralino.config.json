{
  "applicationId": "cat.randomthoughts.builder",
  "version": "1.0.0",
  "applicationName": "Random Thoughts Studio",
  "description": "Article builder for Random Thoughts — desktop editor in a native webview",
  "author": "Dihan Ramanayaka",
  "applicationIcon": "buildAssets/appIcon.png",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "modes": {
    "window": {
      "title": "Random Thoughts — Test Editor",
      "width": 1280,
      "height": 860,
      "minWidth": 700,
      "minHeight": 480,
      "center": true,
      "resizable": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "borderless": false,
      "enableInspector": true,
      "exitProcessOnClose": true,
      "icon": "/resources/icons/appIcon.png"
    }
  },
  "cli": {
    "binaryName": "builder",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}